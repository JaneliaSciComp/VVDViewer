// Java2D AlphaMath.c mul8table
static inline int Mul8(int a, int b)
{
	if (a == 0 || b == 0) return 0;
	unsigned int inc = ((unsigned)a << 16) + ((unsigned)a << 8) + (unsigned)a;
	return (int)(((inc * (unsigned)b) + (1u << 23)) >> 24) & 0xff;
}

// ImageProcessor.drawString(s, x, y) on a ColorProcessor with antialiased
// text (ImageJ draws the region (x, y-h, width(s), h) into a Java2D
// BufferedImage, draws the string at the baseline h-descent, inserts it back)
static int TextWidth(const GlyphFont& f, const std::string& s)
{
	int pen = 0, right = 0;
	for (unsigned char c : s)
	{
		for (int i = 0; i < f.nglyph; i++)
			if (f.g[i].code == c)
			{
				if (f.g[i].w > 0) right = std::max(right, pen + f.g[i].x0 + f.g[i].w);
				pen += f.g[i].adv;
				break;
			}
	}
	return std::max(pen, right);
}
static void DrawText(ImgRGB& im, const GlyphFont& f, const std::string& s, int x, int y, uint32_t fg)
{
	const int w = TextWidth(f, s), h = f.height, descent = f.descent;
	const int cxx = x;
	if (w <= 0 || h <= 0) return;
	// (ImageJ falls back to non-antialiased text when cxx<0 or y-h<0; the
	// macro's positions never do)
	const int srcR = kLcdInvGamma[(fg >> 16) & 0xff], srcG = kLcdInvGamma[(fg >> 8) & 0xff], srcB = kLcdInvGamma[fg & 0xff];
	int pen = 0;
	const int baseline = h - descent;
	for (unsigned char c : s)
	{
		const GlyphRec* g = nullptr;
		for (int i = 0; i < f.nglyph; i++) if (f.g[i].code == c) { g = &f.g[i]; break; }
		if (!g) continue;
		for (int gy = 0; gy < g->h; gy++)
			for (int gx = 0; gx < g->w; gx++)
			{
				int m = g->m[gy * g->w + gx];
				if (!m) continue;
				int bx = pen + g->x0 + gx, by = baseline + g->y0 + gy;	// in the w x h buffer
				if (bx < 0 || bx >= w || by < 0 || by >= h) continue;
				int X = cxx + bx, Y = y - h + by;
				if (X < 0 || X >= im.w || Y < 0 || Y >= im.h) continue;
				uint32_t& d = im.p[(size_t)Y * im.w + X];
				if (m == 255) { d = fg & 0xffffff; continue; }
				int dR = kLcdInvGamma[(d >> 16) & 0xff], dG = kLcdInvGamma[(d >> 8) & 0xff], dB = kLcdInvGamma[d & 0xff];
				int r = kLcdGamma[Mul8(m, srcR) + Mul8(255 - m, dR)];
				int gg = kLcdGamma[Mul8(m, srcG) + Mul8(255 - m, dG)];
				int b = kLcdGamma[Mul8(m, srcB) + Mul8(255 - m, dB)];
				d = ((uint32_t)r << 16) | ((uint32_t)gg << 8) | (uint32_t)b;
			}
		pen += g->adv;
	}
}
