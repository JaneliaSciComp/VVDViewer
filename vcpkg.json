{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg/master/scripts/vcpkg.schema.json",
  "name": "vvdviewer",
  "version-string": "2.19.0",
  "description": "VVDViewer dependencies, auto-built by vcpkg. All static except wxWidgets, ffmpeg and libCZI (dynamic). Vulkan SDK is provided externally and is NOT managed here.",
  "dependencies": [
    "boost-system",
    "boost-chrono",
    "boost-filesystem",
    "boost-graph",
    "boost-property-tree",
    "boost-signals2",
    "boost-smart-ptr",
    "boost-unordered",
    "boost-optional",
    "boost-lexical-cast",
    "boost-foreach",
    "zlib",
    "libdeflate",
    "libjpeg-turbo",
    "tiff",
    "libpng",
    "openssl",
    {
      "name": "curl",
      "features": [ "ssl" ]
    },
    "freetype",
    "bzip2",
    "lz4",
    "zstd",
    "blosc2",
    {
      "name": "hdf5",
      "default-features": false,
      "features": [ "cpp", "hl", "zlib" ]
    },
    {
      "name": "ffmpeg",
      "default-features": false,
      "features": [ "avcodec", "avformat", "avdevice", "avfilter", "swscale", "swresample" ]
    },
    "wxwidgets",
    "libczi",
    {
      "name": "gtk3",
      "features": [ "wayland" ],
      "platform": "linux"
    }
  ],
  "features": {
    "gpl": {
      "description": "Build ffmpeg with the GPL x264/x265 encoders (movie export uses H.264 instead of MPEG-4 Part 2). Binary packages built with this feature are covered by the GPL. Enabled by build.ps1 -EnableGPL / build.sh --enable-gpl.",
      "dependencies": [
        {
          "name": "ffmpeg",
          "default-features": false,
          "features": [ "gpl", "x264", "x265" ]
        }
      ]
    }
  }
}
